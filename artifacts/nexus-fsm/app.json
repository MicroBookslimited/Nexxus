{
  "expo": {
    "name": "NEXXUS FSM",
    "slug": "nexus-fsm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexus-fsm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1220"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.nexxuspos.fsm"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f950a966-11a6-42ae-9863-904af8ef8e18"
      }
    },
    "owner": "microbooks"
  }
}
